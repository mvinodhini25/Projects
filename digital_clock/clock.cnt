module clkcnt (input clk, rst, tick, output reg [5:0]secs, mins);

always@(posedge clk) begin
if(rst) begin
secs <= 6'd0;
mins <= 6'd0;
end
else if(tick) begin

if(secs == 6'd59) begin
secs <= 6'd0;

if(mins == 6'd59)
mins <= 6'd0;
else 
mins <= mins + 6'd1;

end

else
secs <= secs + 6'd1;

end
end

endmodule
